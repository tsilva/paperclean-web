# Public web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudflare R2 (S3-compatible credentials)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=paperclean-private

# Vercel -> Cloudflare job ingress and Cloudflare -> Vercel callbacks
CLOUDFLARE_ORCHESTRATOR_URL=
JOB_DISPATCH_SECRET=
JOB_CALLBACK_SECRET=

# Optional Cloudflare-origin gate. Set the same value as the Cloudflare Transform Rule header.
CLOUDFLARE_ORIGIN_SECRET=

# 7 days in seconds
ASSET_RETENTION_SECONDS=604800
